# Copy to .env on the hosting PC only. Replace both placeholder secrets.
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
REGISTRATION_CODE=REPLACE_WITH_A_PRIVATE_STAFF_INVITATION_CODE
APP_BIND_ADDRESS=192.168.0.50
APP_URL=http://192.168.0.50:3000
# HTTP LAN testing only. Use HTTPS and true for regular staff use.
COOKIE_SECURE=false
