{
  "name": "marina-homes-helpdesk",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "test": "tsx --test tests/*.test.ts",
    "password:reset": "tsx scripts/reset-password.ts",
    "test:integration": "tsx scripts/test-integration.ts",
    "format": "prettier --write app components lib scripts tests *.json *.ts *.md *.yaml Dockerfile .env.example --ignore-unknown"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "lucide-react": "^0.468.0",
    "next": "latest",
    "pg": "^8.16.3",
    "react": "latest",
    "react-dom": "latest",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "embedded-postgres": "^17.9.0-beta.17",
    "prettier": "^3.9.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
